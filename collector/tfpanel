#!/bin/sh
# tfpanel：TensorFold 副屏仪表盘启动器
# 找到 tensorfold 命令所用的 Python（读它第一行 #!），用它运行同目录下的 tfpanel.py

SELF=$(readlink -f "$0" 2>/dev/null || echo "$0")
DIR=$(dirname "$SELF")
PY_FILE="$DIR/tfpanel.py"

TF=$(command -v tensorfold) || {
    echo "[tfpanel] 错误：找不到 tensorfold 命令，请先安装 TensorFold 或把它加入 PATH" >&2
    exit 1
}

if [ ! -f "$PY_FILE" ]; then
    echo "[tfpanel] 错误：找不到 $PY_FILE" >&2
    exit 1
fi

# 从 tensorfold 可执行文件第一行的 shebang 取 Python 路径
SHEBANG=$(head -n 1 "$TF" | sed 's/^#![[:space:]]*//')
PY=${SHEBANG%% *}
case $SHEBANG in
  *" "*) PY="$PY $(printf '%s' "$SHEBANG" | cut -d' ' -f2)" ;;
esac
[ -n "$PY" ] || {
    echo "[tfpanel] 错误：无法从 $TF 解析 Python 路径（第一行不是 shebang？）" >&2
    exit 1
}

# shellcheck disable=SC2086
exec $PY "$PY_FILE" "$@"
